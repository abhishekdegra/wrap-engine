# Virtualenv / packaging
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*$py.class

# Secrets — never commit
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.cursor/
.vscode/
.idea/
*.swp
*.swo
*~

# Debug / local dumps
*.log
debug-*.log

# App exports and inspection crops (regenerated locally)
output/**
!output/.gitkeep

# Generated sample PNGs/JPGs (created on first run / smoke-test)
assets/covers/*
!assets/covers/.gitkeep
assets/examples/*
!assets/examples/.gitkeep
assets/icons/*
!assets/icons/.gitkeep

